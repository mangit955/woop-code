{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ./prune-worktrees.ts",
            "timeout": 30,
            "statusMessage": "Pruning stale agent worktrees"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun ./verify.ts --hook",
            "timeout": 120,
            "statusMessage": "Verifying the staged change"
          }
        ]
      }
    ]
  }
}
