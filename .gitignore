node_modules
.env

# OS noise
.DS_Store

# Build output
# site/dist/ is deliberately committed — it is Vercel's outputDirectory — so
# there is no blanket dist/ rule here. A rule like that would silently ignore
# new files the static build adds to it.
*.tgz
*.log

# Bun is the package manager for this repo (see CLAUDE.md); bun.lock is the
# lockfile. A second lockfile means a second possible dependency tree, and
# whichever one a contributor's tooling picks decides what they actually test.
package-lock.json
yarn.lock
pnpm-lock.yaml

# Harbor benchmark output. `harbor run` writes a directory per job here holding
# trial logs, trajectories and rewards — regenerable artifacts of a specific
# run, not source. They also carry the full task instructions and agent
# transcripts, which do not belong in version control.
jobs/

# Python caches from the Harbor agent's test suite.
__pycache__/
.pytest_cache/

# User state, which lives in ~/.config/woopcode/ and never in the repo. Both
# were committed under config/ once, where nothing imported them — the running
# program reads the copies under getConfigDir() (config/paths.ts). Scoped to
# config/ rather than blanket-ignored: config/models.json is real source, and a
# bare `conversation.json` rule would also hide a fixture with that name.
config/providers.json
config/conversation.json
config/execution-log.json

# Local agent worktrees. Full repo copies; regenerable, and large enough to slow
# every search over the tree.
.claude/worktrees/
